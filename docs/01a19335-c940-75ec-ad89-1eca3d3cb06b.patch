+import type { User } from '@supabase/supabase-js'
+
+/** Authentication fails closed on timeout, network error and missing configuration. */
+export async function verifySession(
+  token: string | undefined,
+  verify: (token: string, signal: AbortSignal) => Promise<{ data: { user: User | null }; error: unknown }>,
+  timeoutMs = 4000,
+): Promise<User | null> {
+  if (!token) return null
+  const controller = new AbortController()
+  let timer: ReturnType<typeof setTimeout> | undefined
+  try {
+    return await Promise.race([
+      Promise.resolve().then(() => verify(token, controller.signal)).then(({ data, error }) => error ? null : data.user),
+      new Promise<null>((resolve) => {
+        timer = setTimeout(() => { controller.abort(); resolve(null) }, timeoutMs)
+      }),
+    ])
+  } catch {
+    return null
+  } finally {
+    clearTimeout(timer)
+  }
+}
diff --git a/supabase/migrations/012_limites_publicacion_en_bd.sql b/supabase/migrations/012_limites_publicacion_en_bd.sql
new file mode 100644
index 0000000..deca388
--- /dev/null
+++ b/supabase/migrations/012_limites_publicacion_en_bd.sql
@@ -0,0 +1,76 @@
+-- Enforce plan quotas for ALL writers (REST, API and dashboard), not just forms.
+-- No existing listings/photos are deleted or paused by this migration.
+BEGIN;
+
+CREATE OR REPLACE FUNCTION public.plan_efectivo_publicacion(p_user uuid)
+RETURNS text LANGUAGE sql STABLE SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+  SELECT COALESCE((
+    SELECT s.plan::text FROM public.suscripciones s
+    WHERE s.user_id = p_user AND s.estado::text IN ('activa','trial')
+      AND s.inicio <= now() AND (s.fin IS NULL OR s.fin > now())
+      AND (s.estado::text <> 'trial' OR s.trial_ends_at > now())
+    ORDER BY s.created_at DESC, s.id DESC LIMIT 1
+  ), 'gratuita');
+$$;
+REVOKE ALL ON FUNCTION public.plan_efectivo_publicacion(uuid) FROM PUBLIC, anon, authenticated;
+
+CREATE OR REPLACE FUNCTION public.exigir_cupo_inmueble()
+RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+DECLARE v_plan text; v_max integer; v_count bigint;
+BEGIN
+  -- Existing excess inventory after a downgrade may be edited or paused.
+  -- Only a NEW active listing, reactivation or ownership transfer consumes a slot.
+  IF NEW.activo IS NOT TRUE THEN RETURN NEW; END IF;
+  IF TG_OP = 'UPDATE' THEN
+    IF OLD.activo IS TRUE AND OLD.usuario_id IS NOT DISTINCT FROM NEW.usuario_id THEN RETURN NEW; END IF;
+  END IF;
+  -- Serialize all quota consumers for this account, including concurrent REST writes.
+  PERFORM 1 FROM public.perfiles WHERE id = NEW.usuario_id FOR UPDATE;
+  IF NOT FOUND THEN RAISE EXCEPTION 'Cuenta no encontrada' USING ERRCODE = '23503'; END IF;
+  v_plan := public.plan_efectivo_publicacion(NEW.usuario_id);
+  v_max := CASE v_plan WHEN 'agencia' THEN 999999 WHEN 'profesional' THEN 10 ELSE 3 END;
+  SELECT count(*) INTO v_count FROM public.inmuebles
+    WHERE usuario_id = NEW.usuario_id AND activo IS TRUE AND id IS DISTINCT FROM NEW.id;
+  IF v_count >= v_max THEN
+    RAISE EXCEPTION 'Límite de publicaciones alcanzado para el plan %', v_plan USING ERRCODE = '23514';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+REVOKE ALL ON FUNCTION public.exigir_cupo_inmueble() FROM PUBLIC, anon, authenticated;
+DROP TRIGGER IF EXISTS exigir_cupo_inmueble ON public.inmuebles;
+CREATE TRIGGER exigir_cupo_inmueble BEFORE INSERT OR UPDATE OF activo, usuario_id
+  ON public.inmuebles FOR EACH ROW EXECUTE FUNCTION public.exigir_cupo_inmueble();
+
+CREATE OR REPLACE FUNCTION public.exigir_cupo_imagen()
+RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER
+SET search_path = pg_catalog, public
+AS $$
+DECLARE v_user uuid; v_plan text; v_max integer; v_count bigint;
+BEGIN
+  -- Reordering/changing an existing photo does not consume another slot.
+  IF TG_OP = 'UPDATE' THEN
+    IF OLD.inmueble_id IS NOT DISTINCT FROM NEW.inmueble_id THEN RETURN NEW; END IF;
+  END IF;
+  SELECT usuario_id INTO v_user FROM public.inmuebles WHERE id = NEW.inmueble_id;
+  IF NOT FOUND THEN RAISE EXCEPTION 'Inmueble no encontrado' USING ERRCODE = '23503'; END IF;
+  PERFORM 1 FROM public.perfiles WHERE id = v_user FOR UPDATE;
+  v_plan := public.plan_efectivo_publicacion(v_user);
+  v_max := CASE v_plan WHEN 'agencia' THEN 30 WHEN 'profesional' THEN 20 ELSE 8 END;
+  SELECT count(*) INTO v_count FROM public.inmueble_imagenes
+    WHERE inmueble_id = NEW.inmueble_id AND id IS DISTINCT FROM NEW.id;
+  IF v_count >= v_max THEN
+    RAISE EXCEPTION 'Límite de fotos alcanzado para el plan %', v_plan USING ERRCODE = '23514';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+REVOKE ALL ON FUNCTION public.exigir_cupo_imagen() FROM PUBLIC, anon, authenticated;
+DROP TRIGGER IF EXISTS exigir_cupo_imagen ON public.inmueble_imagenes;
+CREATE TRIGGER exigir_cupo_imagen BEFORE INSERT OR UPDATE OF inmueble_id
+  ON public.inmueble_imagenes FOR EACH ROW EXECUTE FUNCTION public.exigir_cupo_imagen();
+COMMIT;
diff --git a/tests/security-quota-concurrency.py b/tests/security-quota-concurrency.py
new file mode 100644
index 0000000..aa869f0
--- /dev/null
+++ b/tests/security-quota-concurrency.py
@@ -0,0 +1,59 @@
+"""Optional real-PostgreSQL concurrency regression; never connects to Supabase.
+Run in an isolated venv with pgserver and psycopg[binary] installed.
+"""
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from tempfile import mkdtemp
+from threading import Barrier
+import time
+import pgserver
+import psycopg
+
+server = pgserver.get_server(mkdtemp(prefix='quota-regression-'), cleanup_mode='delete')
+try:
+    uri = server.get_uri()
+    with psycopg.connect(uri, autocommit=True) as db:
+        # Same minimal relational contract used by the PGlite tests.
+        source = Path(__file__).with_name('security-quotas.mjs').read_text()
+        db.execute(source.split('await db.exec(`', 1)[1].split('`)', 1)[0])
+        db.execute((Path(__file__).parents[1] / 'supabase/migrations/012_limites_publicacion_en_bd.sql').read_text())
+        uid = db.execute('INSERT INTO perfiles DEFAULT VALUES RETURNING id').fetchone()[0]
+        ids = [db.execute('INSERT INTO inmuebles(usuario_id) VALUES(%s) RETURNING id', (uid,)).fetchone()[0] for _ in range(2)]
+
+        def race(sql, params):
+            barrier = Barrier(3)
+            def writer():
+                with psycopg.connect(uri, autocommit=True, application_name='quota-race') as conn:
+                    barrier.wait(timeout=10)
+                    try:
+                        conn.execute(sql, params)
+                        return 'ok'
+                    except psycopg.Error as error:
+                        return error.sqlstate
+            # Hold the shared quota lock until BOTH independent connections are blocked.
+            db.execute('BEGIN')
+            db.execute('SELECT id FROM perfiles WHERE id=%s FOR UPDATE', (uid,))
+            with ThreadPoolExecutor(max_workers=2) as pool:
+                futures = [pool.submit(writer) for _ in range(2)]
+                barrier.wait(timeout=10)
+                deadline = time.monotonic() + 10
+                waiting = 0
+                while time.monotonic() < deadline:
+                    waiting = db.execute("SELECT count(*) FROM pg_stat_activity WHERE application_name='quota-race' AND wait_event_type='Lock'").fetchone()[0]
+                    if waiting == 2:
+                        break
+                    time.sleep(0.01)
+                db.execute('COMMIT')
+                results = [f.result(timeout=10) for f in futures]
+            assert waiting == 2, 'Test did not exercise overlapping transactions'
+            assert sorted(results) == ['23514', 'ok'], results
+
+        race('INSERT INTO inmuebles(usuario_id) VALUES(%s)', (uid,))
+        assert db.execute('SELECT count(*) FROM inmuebles WHERE usuario_id=%s AND activo', (uid,)).fetchone()[0] == 3
+        for _ in range(7):
+            db.execute('INSERT INTO inmueble_imagenes(inmueble_id) VALUES(%s)', (ids[0],))
+        race('INSERT INTO inmueble_imagenes(inmueble_id) VALUES(%s)', (ids[0],))
+        assert db.execute('SELECT count(*) FROM inmueble_imagenes WHERE inmueble_id=%s', (ids[0],)).fetchone()[0] == 8
+        print('PASS: two independent concurrent PostgreSQL writers cannot exceed the last listing or photo slot.')
+finally:
+    server.cleanup()
diff --git a/tests/security-quotas.mjs b/tests/security-quotas.mjs
new file mode 100644
index 0000000..36d4677
--- /dev/null
+++ b/tests/security-quotas.mjs
@@ -0,0 +1,85 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { PGlite } from '@electric-sql/pglite'
+const db=new PGlite()
+await db.exec(`
+CREATE ROLE anon; CREATE ROLE authenticated;
+CREATE TABLE perfiles(id uuid PRIMARY KEY DEFAULT gen_random_uuid());
+CREATE TABLE suscripciones(id uuid PRIMARY KEY DEFAULT gen_random_uuid(),user_id uuid REFERENCES perfiles,plan text,estado text,inicio timestamptz DEFAULT now(),fin timestamptz,trial_ends_at timestamptz,created_at timestamptz DEFAULT now());
+CREATE TABLE inmuebles(id uuid PRIMARY KEY DEFAULT gen_random_uuid(),usuario_id uuid REFERENCES perfiles,activo boolean DEFAULT true,vendido boolean DEFAULT false,titulo text);
+CREATE TABLE inmueble_imagenes(id uuid PRIMARY KEY DEFAULT gen_random_uuid(),inmueble_id uuid REFERENCES inmuebles,orden integer DEFAULT 0);
+GRANT SELECT,INSERT,UPDATE ON inmuebles,inmueble_imagenes TO authenticated;
+`)
+await db.exec(readFileSync(new URL('../supabase/migrations/012_limites_publicacion_en_bd.sql',import.meta.url),'utf8'))
+const one=async(sql,params=[]) => (await db.query(sql,params)).rows[0]
+const user=async(plan='gratuita',state='activa',offset='1 day')=>{
+ const {id}=await one('INSERT INTO perfiles DEFAULT VALUES RETURNING id')
+ if(plan!=='gratuita') await db.query(`INSERT INTO suscripciones(user_id,plan,estado,fin,trial_ends_at) VALUES($1,$2,$3,now()+$4::interval,now()+$4::interval)`,[id,plan,state,offset])
+ return id
+}
+const listing=async(uid,active=true)=>(await one('INSERT INTO inmuebles(usuario_id,activo) VALUES($1,$2) RETURNING id',[uid,active])).id
+const photo=async(id)=>db.query('INSERT INTO inmueble_imagenes(inmueble_id) VALUES($1)',[id])
+test('direct writes obey 3/10 limits and agency supports more than ten',async()=>{
+ for(const [plan,max] of [['gratuita',3],['profesional',10],['agencia',12]]) {
+  const uid=await user(plan);for(let i=0;i<max;i++) await listing(uid)
+  if(plan!=='agencia') await assert.rejects(()=>listing(uid),/Límite de publicaciones/)
+  else await listing(uid)
+ }
+})
+test('reactivation cannot bypass quota; pausing frees a slot',async()=>{
+ const uid=await user();const first=await listing(uid);await listing(uid);await listing(uid)
+ const paused=await listing(uid,false)
+ await assert.rejects(()=>db.query('UPDATE inmuebles SET activo=true WHERE id=$1',[paused]),/Límite/)
+ await db.query('UPDATE inmuebles SET activo=false WHERE id=$1',[first])
+ await db.query('UPDATE inmuebles SET activo=true WHERE id=$1',[paused])
+})
+test('photo quotas apply at 8/20/30 and moving images cannot bypass quota',async()=>{
+ for(const [plan,max] of [['gratuita',8],['profesional',20],['agencia',30]]) {
+  const uid=await user(plan),id=await listing(uid)
+  for(let i=0;i<max;i++) await photo(id)
+  await assert.rejects(()=>photo(id),/Límite de fotos/)
+  await db.query('UPDATE inmueble_imagenes SET orden=2 WHERE inmueble_id=$1',[id])
+  const other=await listing(uid);await photo(other)
+  await assert.rejects(()=>db.query('UPDATE inmueble_imagenes SET inmueble_id=$1 WHERE inmueble_id=$2',[id,other]),/Límite de fotos/)
+ }
+})
+test('expired trials/subscriptions and future subscriptions do not grant paid limits',async()=>{
+ for(const state of ['activa','trial']) {
+  const uid=await user('agencia',state,'-1 day')
+  for(let i=0;i<3;i++) await listing(uid)
+  await assert.rejects(()=>listing(uid),/Límite/)
+ }
+ const uid=await user('agencia');await db.query("UPDATE suscripciones SET inicio=now()+interval '1 hour' WHERE user_id=$1",[uid])
+ for(let i=0;i<3;i++) await listing(uid)
+ await assert.rejects(()=>listing(uid),/Límite/)
+})
+test('existing excess after downgrade is preserved/editable, not newly extendable',async()=>{
+ const uid=await user('agencia'), ids=[]
+ for(let i=0;i<4;i++) ids.push(await listing(uid))
+ for(let i=0;i<9;i++) await photo(ids[0])
+ await db.query("UPDATE suscripciones SET estado='cancelada' WHERE user_id=$1",[uid])
+ await db.query("UPDATE inmuebles SET activo=true,titulo='Updated' WHERE usuario_id=$1",[uid])
+ assert.equal((await one('SELECT count(*) FROM inmuebles WHERE usuario_id=$1',[uid])).count,4)
+ await assert.rejects(()=>listing(uid),/Límite/)
+ await assert.rejects(()=>photo(ids[0]),/Límite/)
+ await db.query('UPDATE inmueble_imagenes SET orden=1 WHERE inmueble_id=$1',[ids[0]])
+})
+test('authenticated role cannot bypass triggers and cannot execute quota internals',async()=>{
+ const uid=await user();for(let i=0;i<3;i++) await listing(uid)
+ await db.exec('SET ROLE authenticated')
+ try { await assert.rejects(()=>listing(uid),/Límite/)
+ await assert.rejects(()=>db.query('SELECT plan_efectivo_publicacion($1)',[uid]),/permission denied/) }
+ finally { await db.exec('RESET ROLE') }
+})
+test('multi-row insertion rolls back all rows when the quota would be exceeded',async()=>{
+ const uid=await user()
+ await assert.rejects(()=>db.query('INSERT INTO inmuebles(usuario_id) SELECT $1::uuid FROM generate_series(1,4)',[uid]),/Límite/)
+ assert.equal((await one('SELECT count(*) FROM inmuebles WHERE usuario_id=$1',[uid])).count,0)
+})
+test('migration can be reapplied without deleting existing inventory',async()=>{
+ const before=(await one('SELECT count(*) FROM inmuebles')).count
+ await db.exec(readFileSync(new URL('../supabase/migrations/012_limites_publicacion_en_bd.sql',import.meta.url),'utf8'))
+ assert.equal((await one('SELECT count(*) FROM inmuebles')).count,before)
+})
+test.after(()=>db.close())
