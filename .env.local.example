NEXT_PUBLIC_SUPABASE_URL=https://quxbqmqwiacfwbpqioev.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Current Vercel production origin; replace once the custom domain is connected.
NEXT_PUBLIC_BASE_URL=https://vendet-inmuebles-vende-t.vercel.app
NEXT_PUBLIC_URL=https://vendet-inmuebles-vende-t.vercel.app

# Optional: Cloudflare R2 listing-image storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vendetinmuebles
R2_PUBLIC_URL=

# Optional: Telegram alerts and purchase approval
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required by /api/telegram/webhook; configure the same secret with Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Optional: transactional email (Zoho SMTP)
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# Optional: browser push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=
