# Supabase project: quxbqmqwiacfwbpqioev
NEXT_PUBLIC_SUPABASE_URL=https://quxbqmqwiacfwbpqioev.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production origin for site links, email, and auth redirects.
NEXT_PUBLIC_BASE_URL=https://venezuela-inmuebles.online
NEXT_PUBLIC_URL=https://venezuela-inmuebles.online

# Optional: Cloudflare R2 listing-image storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Set the bucket explicitly; use a new empty bucket or a verified existing one.
R2_BUCKET=
R2_PUBLIC_URL=

# Optional: Telegram alerts and purchase approval
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required by /api/telegram/webhook; configure the same secret with Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Optional: Resend SMTP. Verify the sender domain in Resend before sending.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM='"Venezuela Inmuebles" <noreply@venezuela-inmuebles.online>'

# Datos PUBLICABLES del receptor de Pago Móvil (teléfono, cédula y banco).
# Se sirven en /api/datos-pago para mostrar las instrucciones de pago.
# Mantenerlos fuera de NEXT_PUBLIC_* evita que queden en el bundle del cliente.
PAGO_MOVIL_TELEFONO=
PAGO_MOVIL_CEDULA=
PAGO_MOVIL_BANCO=

# Cron que envía los avisos de correo programados (mensajes de chat sin leer).
# Debe coincidir con el valor usado por el programador (Supabase pg_cron en
# supabase/cron/notificaciones_email_pg_cron.sql, cron externo o Vercel Cron).
# El endpoint espera "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Firma de los enlaces de baja/reactivación incluidos en los correos.
# Si se omite, se usa SUPABASE_SERVICE_ROLE_KEY como secreto.
EMAIL_PREFERENCES_SECRET=

# Optional: browser push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Analytics 4 (Measurement ID del portal; usa G-BSE60G6TX4 por defecto)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-BSE60G6TX4

# Optional: Sentry
NEXT_PUBLIC_SENTRY_DSN=

# Optional: AI description assistant (Google Gemini FREE tier — https://aistudio.google.com)
# Without this key the "Mejorar con IA" button returns 503 and stays unused.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
